# NovaLunch Platform Environment Configuration
# Copy this file to .env and fill in your environment specific keys

# Supabase Realtime & Postgres Connection
SUPABASE_URL="https://your-supabase-project-url.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Local Edge & Hardware Kiosk Settings
SQLITE_DB_PATH="src/database/novalunch_edge.db"
YOLO_MODEL_PATH="src/assets/models/novalunch_yolo.pt"
ACCOUNTS_SEED_PATH="src/database/accounts.json"
RETRAIN_QUEUE_DIR="src/ai_engine/retrain_queue"
TRAYS_QUEUE_DIR="src/ai_engine/trays_queue"
